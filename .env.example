# Roblox 마지막 접속 시간 조회에 사용할 "전용(보조) 계정"의 .ROBLOSECURITY 쿠키 값.
# 이 값은 서버에서만 사용되며 브라우저로 전달되지 않습니다. 절대 커밋하지 마세요.
# 비워 두면 프로필/아바타만 조회되고 접속 정보는 "확인 불가"로 표시됩니다.
ROBLOX_COOKIE=

# 서버(npm start) 포트
PORT=3000

# 리버스 프록시 뒤에서 실행할 때만 1 로 설정 (X-Forwarded-For 로 클라이언트 IP 판별)
# TRUST_PROXY=1

# --- 접속 기록 수집(추적) ---
# 조회된 사용자를 추적 목록에 넣고 주기적으로 접속 상태를 수집합니다. ROBLOX_COOKIE 가 있어야 동작합니다.
# 수집 주기(초). 짧을수록 정확하지만 Roblox 호출 한도/제재 위험이 커집니다.
# TRACK_INTERVAL_SECONDS=300
# 상세 기록(상태 변화) 보관 기간(일). 마지막 접속 시각은 보관 기간과 무관하게 유지됩니다.
# TRACK_RETENTION_DAYS=30
# 추적 대상 최대 수
# TRACK_MAX_TARGETS=200
# SQLite 파일 경로 (기본: data/presence.db)
# TRACK_DB_FILE=
# 추적 중단/기록 삭제 API(DELETE /api/track?id=) 용 토큰. 비워 두면 삭제 API 는 비활성화됩니다.
# ADMIN_TOKEN=
# 로컬 개발 외의 출처(예: 배포한 프런트 도메인)에서 API 를 호출해야 할 때 쉼표로 구분
# ALLOWED_ORIGINS=
